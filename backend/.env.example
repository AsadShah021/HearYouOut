# Copy to .env and fill in. Never commit .env — it holds real secrets.

# MySQL connection. Format:
#   mysql://USER:PASSWORD@HOST:PORT/DATABASE
# If your password contains @ : / or #, URL-encode it (@ becomes %40).
DATABASE_URL="mysql://hearmeout:change_me@localhost:3306/hearmeout"

# Signs the session JWT. Generate a real one — do not ship this placeholder:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-me-with-32-random-bytes"

# How long a login lasts.
JWT_EXPIRES_IN="7d"

PORT=4000
NODE_ENV=development

# The frontend origin allowed to call this API with credentials.
CORS_ORIGIN="http://localhost:3000"

# Public origin of the site. Used to build the Google redirect URI.
APP_URL="http://localhost:3000"

# Google sign-in. Leave blank to disable it — the button then shows a clear
# "not configured" message instead of the server refusing to start.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Transactional email (Resend) — verification codes are sent through this.
# Leave blank in development and codes are printed to the server console
# instead of sent. Production refuses to boot without it, because a signup
# that never receives its code cannot get into the site at all.
#   1. Create a key at https://resend.com/api-keys
#   2. Verify snugtalk.tech under Domains and add the DNS records it gives you
RESEND_API_KEY=""

# Must be on a domain verified in Resend, or delivery fails.
EMAIL_FROM="SnugTalk <hello@snugtalk.tech>"
