# Copy to .env and fill in. Never commit .env — it holds real secrets.

# MySQL connection. Format:
#   mysql://USER:PASSWORD@HOST:PORT/DATABASE
# If your password contains @ : / or #, URL-encode it (@ becomes %40).
DATABASE_URL="mysql://hearmeout:change_me@localhost:3306/hearmeout"

# Signs the session JWT. Generate a real one — do not ship this placeholder:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-me-with-32-random-bytes"

# How long a login lasts.
JWT_EXPIRES_IN="7d"

PORT=4000
NODE_ENV=development

# The frontend origin allowed to call this API with credentials.
CORS_ORIGIN="http://localhost:3000"
